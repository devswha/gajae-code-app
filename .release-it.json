{
  "hooks": { "before:init": ["npm run build"] },
  "npm": { "publish": false },
  "git": { "tagName": "v${version}", "commitMessage": "release: Gajae Code App v${version}", "requireCleanWorkingDir": true, "requireBranch": "main" },
  "github": { "releaseName": "Gajae Code App v${version}", "release": true },
  "plugins": { "@release-it/conventional-changelog": {
    "preset": { "types": [
      { "section": "Capabilities", "type": "feat" },
      { "section": "Capabilities", "type": "feature" },
      { "section": "Corrections", "type": "fix" },
      { "section": "Efficiency", "type": "perf" },
      { "section": "Internal changes", "type": "refactor" },
      { "section": "Guides", "type": "docs" },
      { "section": "Presentation", "type": "style" },
      { "section": "Upkeep", "type": "chore" },
      { "section": "Automation", "type": "ci" },
      { "section": "Coverage", "type": "test" },
      { "section": "Distribution", "type": "build" }
    ], "name": "conventionalcommits" },
    "header": "# Changelog\n\nAll notable changes to Gajae Code App will be documented in this file.\n",
    "infile": "CHANGELOG.md"
  } }
}
