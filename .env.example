# Gajae Code App local environment example
#
# Copy selected settings into .env. Application-owned data defaults to
# ~/.gajae-app; no legacy data directory is read or migrated.
#
# CLI entry points: gajae-app start, gajae-app status, gajae-app help, and
# gajae-app version.

# Network ports
# The API and WebSocket server listens here.
SERVER_PORT=3001
# Vite uses this port while developing the client.
VITE_PORT=5173

# Bind address
# The server itself defaults to 127.0.0.1 when HOST is absent. This example
# deliberately binds both servers to all interfaces; use 127.0.0.1 when remote
# access is not required.
HOST=0.0.0.0

# Vite host admission
# Vite accepts localhost and IP addresses without this setting. To use a DNS
# name, list it here with commas between names; a leading dot matches its
# subdomains.
#
# ALLOWED_HOSTS=macbookpro.tail1e211e.ts.net
# ALLOWED_HOSTS=.tail1e211e.ts.net
# ALLOWED_HOSTS=gjc.example.com,.internal
#
# ALLOWED_HOSTS=* turns off this protection. Do that only on a trusted network:
# the UI can execute commands as the server user.

# Optional Claude executable override.
# CLAUDE_CLI_PATH=claude

# Persistent data
# DATABASE_PATH overrides the authentication database location. Without it,
# the server uses ~/.gajae-app/auth.db for credentials, API keys, and tokens.
# DATABASE_PATH=/path/to/your/custom/auth.db

# Session context limits, expressed as tokens.
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000
